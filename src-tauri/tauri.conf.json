{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GymDeck",
  "version": "0.1.0",
  "identifier": "com.gymdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GymDeck",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 960,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self' blob: data:; object-src 'self' blob: data:;"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.gymdeck.com/desktop/{{target}}/{{current_version}}"
      ],
      "pubkey": "UPDATE_SIGNING_PUBLIC_KEY_PLACEHOLDER"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "wix": {
        "upgradeCode": "35b210b2-1718-4061-9131-016147291b7a"
      },
      "nsis": {
        "languages": ["English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
