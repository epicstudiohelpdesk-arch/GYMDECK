{
  "expo": {
    "name": "GymDeck Owner",
    "slug": "gymdeck-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gymdeck-owner",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymdeck.owner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA4303"
      },
      "package": "com.gymdeck.owner"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EA4303"
        }
      ],
      "expo-build-properties",
      "expo-font",
      "./plugins/withFixConstantsPath"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e308201-cf62-4fc3-912e-80d42dbf8872"
      }
    },
    "owner": "sd_2007"
  }
}
