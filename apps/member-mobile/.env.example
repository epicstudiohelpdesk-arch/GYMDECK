# ==============================================================================
# GymDeck Member Mobile - Environment Configuration Template (.env.example)
#
# DO NOT INCLUDE SENSITIVE SERVER SECRETS IN MOBILE CONFIGURATION.
# All EXPO_PUBLIC_* variables are embedded into the client application binary.
# ==============================================================================

# Target Environment (development | testing | production)
APP_ENV=development

# Cloud Backend API Base URL
# Development: http://10.0.2.2:3001 (Android Emulator) or http://192.168.x.x:3001 (Physical Device)
# Staging: https://staging-api.gymdeck.com
# Production: https://api.gymdeck.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
