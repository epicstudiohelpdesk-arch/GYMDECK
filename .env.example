# GymDeck Environment Configuration
# Copy this file to .env and fill in your values

# Express Session Secret — generate with: openssl rand -hex 64
SESSION_SECRET=your-64-char-hex-secret-here

# Server port (default: 3000)
PORT=3000

# Production: set to true to enable secure cookies (requires HTTPS)
SESSION_SECURE=false

# Tauri Database Encryption Key (production)
# Generate with: openssl rand -hex 32
GYMDECK_DB_KEY=your-64-char-hex-db-encryption-key-here

# Tauri Updater Public Key (set to your signing key for production builds)
# Generate with: npm run tauri signer generate
GYMDECK_UPDATER_PUBKEY=

# Log level: trace, debug, info, warn, error
LOG_LEVEL=info
