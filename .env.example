# ==============================================================================
# GymDeck Desktop Application - Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment (development | staging | production)
GYMDECK_ENV=development

# SQLCipher Database Encryption Key
# In Development: Defaults to internal static key if omitted.
# In Production/Staging: MUST be explicitly set to a 64-char hex key.
GYMDECK_DB_KEY=

# Cloud Synchronization API URL
GYMDECK_CLOUD_URL=https://api.gymdeck.com

# Updater Public Key (Ed25519)
GYMDECK_UPDATER_PUBKEY=UPDATE_SIGNING_PUBLIC_KEY_PLACEHOLDER

# Logging Level (trace | debug | info | warn | error)
LOG_LEVEL=info
