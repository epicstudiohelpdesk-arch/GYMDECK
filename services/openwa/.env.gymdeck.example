# GymDeck - bundled OpenWA sidecar configuration
# Copy to services/openwa/.env (never commit the real file).
# OpenWA is an unofficial WhatsApp Web client. Use a dedicated gym number.

NODE_ENV=development
PORT=2785

# SQLite keeps the sidecar self-contained (no Redis/Postgres required).
DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
DATABASE_SYNCHRONIZE=true
MAIN_DATABASE_NAME=./data/main.sqlite

ENGINE_TYPE=whatsapp-web.js
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
# macOS local Chrome (optional; omit to use Puppeteer's bundled browser):
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false
AUTO_START_SESSIONS=true

# Must match backend OPENWA_API_KEY. 32+ characters in production.
API_MASTER_KEY=dev_openwa_api_key_change_me_32chars

# GymDeck verifies X-OpenWA-Signature with this value. Must match
# backend OPENWA_WEBHOOK_SECRET.
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_DELAY=5000

# Local development only: allows the loopback webhook target.
# In Docker/production keep SSRF protection on and allow the backend host:
#   WEBHOOK_SSRF_PROTECT=true
#   SSRF_ALLOWED_HOSTS=backend
WEBHOOK_SSRF_PROTECT=false

# Public HTTPS URL when GymDeck runs outside this machine.
# OPENWA_WEBHOOK_URL is on the GymDeck backend, not OpenWA.
