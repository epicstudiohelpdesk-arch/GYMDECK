{
  "name": "@gymdeck/cloud-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GymDeck Cloud Backend Gateway & Domain Services",
  "main": "dist/gateway/src/server.js",
  "scripts": {
    "dev": "tsx watch gateway/src/server.ts",
    "build": "tsc",
    "start": "node dist/gateway/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx test/health.test.ts && tsx test/config.test.ts && tsx test/errors.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.11.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "drizzle-kit": "^0.20.18",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
