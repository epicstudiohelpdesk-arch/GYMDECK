# ==============================================================================
# GymDeck Cloud Backend - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL
# Copy this file to .env.local for local development.
# ==============================================================================

# Server Environment Profile (development | staging | production)
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# PostgreSQL Database Connection
DATABASE_URL=postgresql://gymdeck_user:gymdeck_password@localhost:5432/gymdeck_cloud?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Authentication & JWT Secrets (RS256 Private/Public key pair or HS256 Secret)
JWT_SECRET=change_me_to_a_secure_256_bit_random_secret_in_development
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Resend Transactional Email Gateway
RESEND_API_KEY=re_dev_placeholder_api_key
RESEND_FROM_EMAIL=auth@notifications.gymdeck.com

# Redis Cache & Idempotency Store (Optional in Development)
REDIS_URL=redis://localhost:6379

# Object Storage for Document Vault (S3 / Cloudflare R2)
OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=gymdeck-vault-documents
OBJECT_STORAGE_ACCESS_KEY=placeholder_access_key
OBJECT_STORAGE_SECRET_KEY=placeholder_secret_key
OBJECT_STORAGE_REGION=auto
