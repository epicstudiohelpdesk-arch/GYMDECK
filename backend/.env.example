# ==============================================================================
# GymDeck Cloud Backend - Environment Configuration Template (.env.example)
#
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# In production/staging, secrets MUST be injected via a managed secrets manager
# (e.g., AWS Secrets Manager, Parameter Store, Vault).
# ==============================================================================

# Runtime Environment (development | test | staging | production)
NODE_ENV=development

# Server Binding
PORT=3001
HOST=0.0.0.0

# CORS Allowed Origins
# Development: * (or localhost)
# Production: Explicit comma-separated origins (e.g. https://app.gymdeck.com,https://admin.gymdeck.com)
CORS_ORIGINS=*

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://gymdeck_user:gymdeck_password@localhost:5432/gymdeck_cloud?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Authentication & JWT Configuration
# In Production: MUST be a random >= 32-character string generated via CSPRNG
JWT_SECRET=gymdeck_default_dev_jwt_secret_must_be_overridden_in_prod
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Resend Email Gateway
# Required when NOTIFICATION_PROVIDER_MODE=live
RESEND_API_KEY=re_dev_placeholder_key
RESEND_FROM_EMAIL=auth@notifications.gymdeck.com

# Push Notification Gateway (Expo Push)
EXPO_ACCESS_TOKEN=
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# WhatsApp Cloud API (Meta)
WHATSAPP_API_URL=https://graph.facebook.com/v22.0
WHATSAPP_PHONE_NUMBER_ID=dev_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=dev_whatsapp_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev_whatsapp_webhook_verify_token
WHATSAPP_APP_SECRET=dev_whatsapp_app_secret_12345

# Notification Dispatch Mode (live | sandbox | mock)
NOTIFICATION_PROVIDER_MODE=sandbox

# Redis Cache (Optional)
REDIS_URL=
