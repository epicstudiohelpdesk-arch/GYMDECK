# ==============================================================================
# GymDeck Cloud Backend - Environment Configuration Template (.env.example)
#
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# In production/staging, secrets MUST be injected via a managed secrets manager
# (e.g., AWS Secrets Manager, Parameter Store, Vault).
# ==============================================================================

# Runtime Environment (development | test | staging | production)
NODE_ENV=development

# Server Binding
PORT=3001
HOST=0.0.0.0

# CORS Allowed Origins
# Development: * (or localhost)
# Production: Explicit comma-separated origins (e.g. https://app.gymdeck.com,https://admin.gymdeck.com)
CORS_ORIGINS=*

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://gymdeck_user:gymdeck_password@localhost:5432/gymdeck_cloud?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Authentication & JWT Configuration
# In Production: MUST be a random >= 32-character string generated via CSPRNG
JWT_SECRET=gymdeck_default_dev_jwt_secret_must_be_overridden_in_prod
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Resend Email Gateway
# Required when NOTIFICATION_PROVIDER_MODE=live
RESEND_API_KEY=re_dev_placeholder_key
RESEND_FROM_EMAIL=auth@notifications.gymdeck.com

# Brevo Transactional Email API (backend only; never expose to the frontend)
# API key must be a v3 API key created in Brevo -> SMTP & API -> API Keys.
# SMTP relay keys are only valid for SMTP submission, not the v3 API.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@mail.epic-studio.in
BREVO_SENDER_NAME=GymDeck

# Push Notification Gateway (Expo Push)
EXPO_ACCESS_TOKEN=
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# WhatsApp provider (OpenWA sidecar)
WHATSAPP_PROVIDER=openwa
OPENWA_API_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=dev_openwa_api_key_change_me_32chars
OPENWA_WEBHOOK_SECRET=dev_openwa_webhook_secret_32chars
OPENWA_WEBHOOK_URL=http://127.0.0.1:3001/v1/webhooks/openwa
OPENWA_REQUEST_TIMEOUT_MS=30000
OPENWA_SESSION_PREFIX=gymdeck
OPENWA_ENGINE=whatsapp-web.js

WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_MAX_SENDS_PER_HOUR=300
WHATSAPP_QUEUE_BATCH_SIZE=20
WHATSAPP_WORKER_INTERVAL_MS=15000

# Authorised recipient for the manual gateway check (E.164 without +).
WHATSAPP_TEST_RECIPIENT=

# Notification Dispatch Mode (live | sandbox | mock)
NOTIFICATION_PROVIDER_MODE=sandbox

# Mode A communications: facility timezone used for quiet-hours policy
COMMUNICATION_TIMEZONE=Asia/Kolkata

# Redis Cache (Optional)
REDIS_URL=

# --- Email Line (Postal rollback) -------------------------------------------
POSTAL_API_URL=http://127.0.0.1:5000/api/v1
POSTAL_SERVER_API_KEY=
POSTAL_WEBHOOK_KEY=
POSTAL_SIGNING_PUBLIC_KEY=
POSTAL_SIGNING_KEY_ID=
POSTAL_AUTHORIZED_PUBLIC_KEYS=
POSTAL_ALLOW_LEGACY_SHA1=false
POSTAL_FROM_DOMAIN=mail.epic-studio.in
POSTAL_DEFAULT_FROM_NAME=GymDeck
POSTAL_DEFAULT_FROM_EMAIL=notifications@mail.epic-studio.in
POSTAL_DELIVERY_MODE=mock
POSTAL_INSTANCE_ID=default

# --- Email Line (shared / Brevo) --------------------------------------------
EMAIL_DELIVERY_PROVIDER=postal
EMAIL_LIVE_SEND_ENABLED=false
BREVO_DELIVERY_MODE=mock
BREVO_WEBHOOK_SECRET=
EMAIL_MONTHLY_QUOTA_DEFAULT=300
EMAIL_WORKER_INTERVAL_MS=5000
EMAIL_BATCH_SIZE=25
EMAIL_STAGING_LIVE_TEST_ENABLED=false
EMAIL_STAGING_AUTHORIZED_RECIPIENTS=
EMAIL_STAGING_DAILY_LIMIT=10

# --- Storage, encryption, TURN ----------------------------------------------
STORAGE_ENDPOINT=https://vault.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PAYMENT_ENCRYPTION_KEY=
TURN_SHARED_SECRET=
TURN_SERVER_HOST=
STUN_SERVER=stun:stun.l.google.com:19302

# --- Database TLS -----------------------------------------------------------
# Production fails closed unless mode=verify and CA file is readable.
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA=

# --- Staging Compose injection variables -------------------------------------
# Required by infrastructure/docker/docker-compose.staging.yml. These are
# injected by the deploy environment / secrets manager, not by the backend app.
# POSTGRES_STAGING_PASSWORD=
# JWT_STAGING_SECRET=
# OPENWA_STAGING_API_KEY=
# OPENWA_STAGING_WEBHOOK_SECRET=
# CORS_ORIGINS_STAGING=
# PAYMENT_ENCRYPTION_KEY_STAGING=
# STORAGE_ACCESS_KEY_STAGING=
# STORAGE_SECRET_KEY_STAGING=
# EMAIL_DELIVERY_PROVIDER_STAGING=postal
# EMAIL_LIVE_SEND_ENABLED_STAGING=false
# BREVO_DELIVERY_MODE_STAGING=mock
# BREVO_API_KEY_STAGING=
# BREVO_SENDER_EMAIL_STAGING=notifications@mail.epic-studio.in
# BREVO_WEBHOOK_SECRET_STAGING=
# POSTAL_API_URL_STAGING=http://postal-relay.invalid/api/v1
# POSTAL_SERVER_API_KEY_STAGING=
# POSTAL_SIGNING_PUBLIC_KEY_STAGING=
# POSTAL_INSTANCE_ID_STAGING=default
# POSTAL_DELIVERY_MODE_STAGING=mock
# DATABASE_SSL_MODE_STAGING=disable
