# ==============================================================================
# Postal v3.4.0 Native ARM64 (OCI Ampere A1 Staging/Production) Environment File
# ==============================================================================
# STRICT OPERATIONAL SAFETY: Do NOT commit secrets or actual credentials to Git.
# Populate these placeholders on the target Oracle Cloud VM before startup.

# MariaDB Credentials
MARIADB_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT_PASSWORD_STRONG_HEX
MARIADB_PASSWORD=CHANGE_ME_MARIADB_USER_PASSWORD_STRONG_HEX

# Postal Web/API Domain & Port Configuration
POSTAL_HOST=mail.epic-studio.in
POSTAL_WEB_PORT=5000
POSTAL_SMTP_PORT=25

# Rails Application Secret Key (Generate via: openssl rand -hex 64)
POSTAL_SECRET_KEY=CHANGE_ME_RAILS_SECRET_KEY_64_HEX

# OCI Host Configuration
POSTAL_INSTANCE_ID=default
