# Postal Local Staging Environment Variables (.env)
# Used by infrastructure/email-staging/docker-compose.yml

POSTAL_IMAGE=ghcr.io/postalserver/postal:3.4.0
MARIADB_IMAGE=mariadb:10.11.10

# Database credentials (internal to isolated Docker network)
MARIADB_ROOT_PASSWORD=postal_staging_root_pass_change_me
MARIADB_DATABASE=postal
MARIADB_USER=postal
MARIADB_PASSWORD=postal_staging_db_pass_change_me

# Host Bindings (Strictly 127.0.0.1 - Local Only)
POSTAL_WEB_PORT=5000
POSTAL_SMTP_PORT=2525

# Rails Secret Key (Generate with: openssl rand -hex 64)
RAILS_SECRET_KEY=94c8e75db389fae025a1e50882e850b6c6b3ef9a7c3850ea7ff4a682f6e9b418e974e64f77a835b0e8c752b57e7dbb54332f1469e71c66795f9d12d45bc8360f

# Postal Web / SMTP Hostname Configuration
POSTAL_WEB_HOSTNAME=localhost:5000
POSTAL_WEB_PROTOCOL=http
POSTAL_SMTP_HOSTNAME=localhost
